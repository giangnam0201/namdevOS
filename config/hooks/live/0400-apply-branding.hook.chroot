#!/bin/bash
#
# Apply namdevOS branding to system locations
# Copies wallpapers, logos, Plymouth theme, LightDM config, and GTK overrides
#

set -euo pipefail

echo "Applying namdevOS branding..."

# Verify staged branding files are available
if [[ ! -d /tmp/branding ]]; then
    echo "WARNING: /tmp/branding not found, skipping branding application"
    exit 0
fi

# Install wallpapers
mkdir -p /usr/share/backgrounds/namdevos
if [[ -f /tmp/branding/wallpapers/namdevos-default.svg ]]; then
    cp /tmp/branding/wallpapers/namdevos-default.svg \
        /usr/share/backgrounds/namdevos/namdevos-default.svg
fi
if [[ -f /tmp/branding/wallpapers/namdevos-minimal.svg ]]; then
    cp /tmp/branding/wallpapers/namdevos-minimal.svg \
        /usr/share/backgrounds/namdevos/namdevos-minimal.svg
fi

# Create wallpaper XML for XFCE background list
cat > /usr/share/gnome-background-properties/namdevos-wallpapers.xml << 'WPEOF'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE wallpapers SYSTEM "gnome-wp-list.dtd">
<wallpapers>
  <wallpaper deleted="false">
    <name>namdevOS Default</name>
    <filename>/usr/share/backgrounds/namdevos/namdevos-default.svg</filename>
    <options>zoom</options>
    <shade_type>solid</shade_type>
  </wallpaper>
  <wallpaper deleted="false">
    <name>namdevOS Minimal</name>
    <filename>/usr/share/backgrounds/namdevos/namdevos-minimal.svg</filename>
    <options>zoom</options>
    <shade_type>solid</shade_type>
  </wallpaper>
</wallpapers>
WPEOF
mkdir -p /usr/share/gnome-background-properties

# Install logo
mkdir -p /usr/share/icons/namdevos
if [[ -f /tmp/branding/logo/namdevos-logo.svg ]]; then
    cp /tmp/branding/logo/namdevos-logo.svg \
        /usr/share/icons/namdevos/namdevos-logo.svg
    # Also install to pixmaps for broader compatibility
    mkdir -p /usr/share/pixmaps
    cp /tmp/branding/logo/namdevos-logo.svg /usr/share/pixmaps/namdevos-logo.svg
fi

# Install Plymouth theme
mkdir -p /usr/share/plymouth/themes/namdevos-theme
if [[ -d /tmp/branding/plymouth/namdevos-theme ]]; then
    cp /tmp/branding/plymouth/namdevos-theme/* \
        /usr/share/plymouth/themes/namdevos-theme/

    # Convert SVG logo to PNG for Plymouth if rsvg-convert is available
    if command -v rsvg-convert &>/dev/null && [[ -f /tmp/branding/logo/namdevos-logo.svg ]]; then
        rsvg-convert -w 128 -h 128 /tmp/branding/logo/namdevos-logo.svg \
            -o /usr/share/plymouth/themes/namdevos-theme/namdevos-logo.png 2>/dev/null || true
    fi
fi

# Configure Plymouth
if command -v update-alternatives &>/dev/null; then
    update-alternatives --install /usr/share/plymouth/themes/default.plymouth default.plymouth \
        /usr/share/plymouth/themes/namdevos-theme/namdevos-theme.plymouth 200 2>/dev/null || true
fi

# Install LightDM greeter configuration
if [[ -f /tmp/branding/lightdm/lightdm-gtk-greeter.conf ]]; then
    mkdir -p /etc/lightdm
    cp /tmp/branding/lightdm/lightdm-gtk-greeter.conf \
        /etc/lightdm/lightdm-gtk-greeter.conf
fi

# Install OS release branding
cat > /etc/lsb-release << 'EOF'
DISTRIB_ID=namdevOS
DISTRIB_RELEASE=1.1
DISTRIB_CODENAME=nova
DISTRIB_DESCRIPTION="namdevOS 1.1 Nova"
EOF

cat > /etc/os-release << 'EOF'
PRETTY_NAME="namdevOS 1.1 Nova"
NAME="namdevOS"
VERSION_ID="1.1"
VERSION="1.1 (Nova)"
VERSION_CODENAME=nova
ID=namdevos
ID_LIKE=ubuntu debian
HOME_URL="https://github.com/namdevOS/namdevOS"
SUPPORT_URL="https://github.com/namdevOS/namdevOS/issues"
BUG_REPORT_URL="https://github.com/namdevOS/namdevOS/issues"
PRIVACY_POLICY_URL="https://github.com/namdevOS/namdevOS"
UBUNTU_CODENAME=noble
EOF

echo "Branding applied successfully"
