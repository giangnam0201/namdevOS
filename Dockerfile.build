# namdevOS Build Environment
# Provides a reproducible build environment with all dependencies pre-installed

FROM ubuntu:24.04

LABEL maintainer="namdevOS Project"
LABEL description="Build environment for namdevOS ISO generation"

# Avoid interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install build dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        live-build \
        debootstrap \
        squashfs-tools \
        xorriso \
        genisoimage \
        isolinux \
        syslinux \
        syslinux-common \
        syslinux-utils \
        mtools \
        grub-efi-amd64-bin \
        apt-utils \
        ca-certificates \
        curl \
        git \
        make \
        shellcheck \
        python3 \
        python3-yaml \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Pre-patch live-build syslinux: comment out theme copy lines (not a full no-op,
# because lb_binary_syslinux still needs to create the isolinux/ boot directory)
RUN SCRIPT=$(dpkg -L live-build 2>/dev/null | grep -m1 'lb_binary_syslinux$' || true) && \
    if [ -n "$SCRIPT" ] && [ -f "$SCRIPT" ]; then \
        sed -i \
            -e 's|^\(.*cp.*themes.*/isolinux-live\)|# PATCHED: \1|' \
            -e 's|^\(.*cp -r.*/usr/share/syslinux/themes\)|# PATCHED: \1|' \
            -e 's|^\(.*Packages_Install.*syslinux-themes\)|# PATCHED: \1|' \
            -e 's|^\(.*gfxboot-theme\)|# PATCHED: \1|' \
            "$SCRIPT"; \
    fi && \
    DEFAULTS=$(find /usr/lib/live /usr/share/live /usr/lib/live-build -name "defaults.sh" -type f 2>/dev/null | head -1) && \
    if [ -n "$DEFAULTS" ] && [ -f "$DEFAULTS" ]; then \
        sed -i 's|LB_SYSLINUX_THEME=.*|LB_SYSLINUX_THEME=""|' "$DEFAULTS"; \
    fi && \
    mkdir -p /usr/share/syslinux/themes/isolinux-live \
             /usr/share/syslinux/themes/ubuntu-oneiric/isolinux-live && \
    touch /usr/share/syslinux/themes/isolinux-live/.keep \
          /usr/share/syslinux/themes/ubuntu-oneiric/isolinux-live/.keep

# Set working directory
WORKDIR /build

# Copy project files
COPY . /build/

# Make scripts executable
RUN find /build -name "*.sh" -exec chmod +x {} \; && \
    chmod +x /build/config/live-build/auto/* && \
    chmod +x /build/config/hooks/live/*.hook.chroot

# Output directory for the ISO
VOLUME ["/output"]

# Default command: build the ISO and copy to output
CMD ["bash", "-c", "bash build.sh && cp output/*.iso /output/ 2>/dev/null || echo 'Build complete'"]
