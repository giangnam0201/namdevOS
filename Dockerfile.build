# namdevOS Build Environment
# Provides a reproducible build environment with all dependencies pre-installed

FROM ubuntu:24.04

LABEL maintainer="namdevOS Project"
LABEL description="Build environment for namdevOS ISO generation"

# Avoid interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install build dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        live-build \
        debootstrap \
        squashfs-tools \
        xorriso \
        isolinux \
        syslinux-common \
        syslinux-utils \
        grub-efi-amd64-bin \
        mtools \
        apt-utils \
        ca-certificates \
        curl \
        git \
        make \
        shellcheck \
        python3 \
        python3-yaml \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Pre-patch live-build syslinux: replace lb_binary_syslinux with no-op
# The script copies theme files that don't exist in Ubuntu 24.04
RUN SCRIPT=$(dpkg -L live-build 2>/dev/null | grep -m1 'lb_binary_syslinux$' || true) && \
    if [ -n "$SCRIPT" ] && [ -f "$SCRIPT" ]; then \
        cp "$SCRIPT" "${SCRIPT}.orig" && \
        printf '#!/bin/sh\n# PATCHED: syslinux themes disabled\nexit 0\n' > "$SCRIPT" && \
        chmod +x "$SCRIPT"; \
    fi && \
    mkdir -p /usr/share/syslinux/themes/isolinux-live \
             /usr/share/syslinux/themes/ubuntu-oneiric/isolinux-live && \
    touch /usr/share/syslinux/themes/isolinux-live/isolinux.cfg \
          /usr/share/syslinux/themes/ubuntu-oneiric/isolinux-live/isolinux.cfg

# Set working directory
WORKDIR /build

# Copy project files
COPY . /build/

# Make scripts executable
RUN find /build -name "*.sh" -exec chmod +x {} \; && \
    chmod +x /build/config/live-build/auto/* && \
    chmod +x /build/config/hooks/live/*.hook.chroot

# Output directory for the ISO
VOLUME ["/output"]

# Default command: build the ISO and copy to output
CMD ["bash", "-c", "bash build.sh && cp output/*.iso /output/ 2>/dev/null || echo 'Build complete'"]
